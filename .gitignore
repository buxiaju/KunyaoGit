# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo

# 构建产物
dist/
dist-electron/
release/
release-v*/
release-*/
release-new/
release3/
out/
.build-config.json

# 日志（统一归档到 logs/）
logs/
*.log

# 本地工具（NSIS 编译器等，不入库）
tools/

# Electron
.electron-cache/

# 编辑器
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# 环境
.env
.env.local
.env.*.local

# 测试
coverage/
.nyc_output/

# 系统
*.dll
*.exe
*.pdb
logs/.commit-msg.tmp

# 安装包（入 .release-assets/ 供 Gitee raw 路径分发，详见 development-guide §8.3）
# 注：v0.6.3 起新版本 NSIS 不再入库（Gitee 仓库体积已近 819MB 上限），只走 Release API 上传
!.release-assets/*.exe
!.release-assets/*.zip

# 一次性调试 / 代码生成脚本（本地保留，不入库）
scripts/dup-*.cjs
scripts/diag-*.cjs
